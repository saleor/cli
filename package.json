{
  "name": "@saleor/cli",
  "version": "2.0.0-alpha.0",
  "description": "Set up and manage Saleor stores in Saleor Cloud or locally, for people and coding agents",
  "homepage": "https://github.com/saleor/saleor-cli#readme",
  "bugs": "https://github.com/saleor/saleor-cli/issues",
  "license": "BSD-3-Clause",
  "author": "Saleor",
  "repository": "github:saleor/saleor-cli",
  "bin": {
    "saleor": "./dist/saleor.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "pnpm lint:code && pnpm lint:policy && pnpm format:check && pnpm lint:effect",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict",
    "lint:fix": "pnpm lint:code --fix && pnpm format",
    "saleor": "node bin/saleor.mjs",
    "test": "vitest run",
    "test:build": "tsdown && SALEOR_CLI_BIN=dist/saleor.mjs vitest run src/main.test.ts src/store-commands.test.ts",
    "test:e2e": "pnpm test:build",
    "test:live": "node scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint:code": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error src scripts bin *.config.ts",
    "format": "oxfmt -c oxfmt.config.ts --write src scripts bin *.config.ts package.json tsconfig.json",
    "format:check": "oxfmt -c oxfmt.config.ts --check src scripts bin *.config.ts package.json tsconfig.json",
    "lint:policy": "node scripts/lint-policy.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "devDependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.53.2",
    "@effect/vitest": "4.0.5",
    "@oxlint/plugins": "1.88.0",
    "@saleor/configurator": "3.23.3",
    "@types/node": "^26.6.5",
    "effect": "4.0.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "nanotar": "0.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tar": "7.5.22",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0"
}
